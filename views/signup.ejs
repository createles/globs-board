<%- include('partials/header.ejs') %>

<% if (locals.errorMessages && errorMessages.length > 0) { %>
  <div id="toast-container" class="toast-container">
    <% errorMessages.forEach(msg => { %>
      <div class="toast">
        <span class="toast-icon">⚠️</span>
        <p class="toast-msg"><%= msg %></p>
        <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
      </div>
    <% }) %>
  </div>
<% } %>

<div class="auth-wrapper" style="max-width: 500px; margin: 3rem auto; padding: 0 1rem;">
  
  <div class="auth-card" style="background-color: var(--surface-low); padding: 2.5rem; border-radius: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
    
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Join the Collective</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">Claim your space in the fluid underground.</p>
    </div>

    <form action="/signup" method="POST">
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="first_name">First Name</label>
          <input type="text" name="first_name" id="first_name" required placeholder="Alex" value="<%= locals.previousInput ? previousInput.first_name : '' %>">
        </div>
        <div>
          <label for="last_name">Last Name</label>
          <input type="text" name="last_name" id="last_name" required placeholder="Hardware" value="<%= locals.previousInput ? previousInput.last_name : '' %>">
        </div>
      </div>

      <label for="username">Username</label>
      <input type="text" name="username" id="username" required placeholder="Choose a unique handle" value="<%= locals.previousInput ? previousInput.username : '' %>">

      <label for="password">Password</label>
      <input type="password" name="password" id="password" required placeholder="Make it secure">

      <label for="confirm_password">Confirm Password</label>
      <input type="password" name="confirm_password" id="confirm_password" required placeholder="Type it one more time">

      <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1.5rem; padding: 1rem;">
        Create Account
      </button>
    </form>

    <p style="text-align: center; margin-top: 2rem; font-size: 0.9rem; color: var(--text-muted);">
      Already a member? <br>
      <a href="/login" style="color: var(--primary); font-weight: 600;">Log in here.</a>
    </p>

  </div>
</div>

<%- include('partials/footer.ejs') %>