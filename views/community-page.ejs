<%- include('partials/header.ejs') %>

<div class="dashboard-container">
  
  <section class="user-profile-card">
    <div class="user-info">
      <h2>g/<%= community.community_name %>
      </h2>
      <p class="handle">
        <%= community.community_description %>
      </p>
    </div>
    <!-- Checked for logged in user -->
    <% if (currentUser) { %>
    <!-- Check if user is a member of the community -->
      <% if (isMember) { %>
        <button class="btn-secondary" disabled>Joined</button>
        <% } else { %>
          <form action="/g/<%= community.community_name %>/join" method="POST" style="margin: 0;">
            <button type="submit" class="btn-primary">Join Community</button>
          </form>
          <% } %>
  
     <!-- If user not logged in, route them to login page -->
      <% } else { %>
        <a href="/login" class="btn-secondary" style="text-decoration: none;">Log in to Join</a>
      <% } %>
  </section>

  <section class="timeline-section">
    <h3>Community Posts</h3>

    <% if (posts && posts.length > 0) { %>
      <div class="feed-container">
        <% posts.forEach(post => { %>
          <article class="post-card">
            
            <div class="post-meta">
              <span class="author">Posted by <%= post.author_name %></span>
              <span class="divider">•</span>
              <span class="date"><%= new Date(post.created_at).toLocaleDateString() %></span>
            </div>
            
            <h4 class="post-title"><%= post.title %></h4>
            <p class="post-body"><%= post.body %></p>
            
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No posts in this community yet. Be the first!</p>
      </div>
    <% } %>
    
  </section>
</div>

<%- include('partials/footer.ejs') %>