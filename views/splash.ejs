<%- include('partials/header.ejs') %>

  <main class="dashboard-container" style="text-align: center; margin-top: 5rem; margin-bottom: 5rem;">

    <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
      <span class="material-symbols-outlined"
        style="font-size: 4rem; color: var(--tertiary); filter: drop-shadow(0 0 20px rgba(161, 250, 255, 0.4)); font-variation-settings: 'FILL' 1;">water_drop</span>
    </div>

    <h1
      style="font-size: 3.5rem; margin-bottom: 1.5rem; color: var(--text-main); line-height: 1.1; letter-spacing: -0.03em;">
      Drip into the <br> <span style="color: var(--primary); font-size: 2.5rem;">blips and blops of thought.</span>
    </h1>

    <p
      style="color: var(--text-muted); font-size: 1.1rem; max-width: 500px; margin: 0 auto 3rem auto; line-height: 1.6;">
      Connect, share, and flow with the current in a space designed for uninterrupted thought. No noise, just a stream.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="/signup" class="btn-primary" style="font-size: 1.1rem; padding: 0.85rem 2rem;">Step into the Glob</a>
      <a href="/login" class="btn-secondary" style="font-size: 1.1rem; padding: 0.85rem 2rem;">Log In</a>
    </div>
  </main>

  <section class="dashboard-container">
    <div style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 2rem;">
      <div style="height: 1px; background: var(--surface-high); flex-grow: 1;"></div>
      <h3
        style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">
        Most recent blops
      </h3>
      <div style="height: 1px; background: var(--surface-high); flex-grow: 1;"></div>
    </div>

    <% if (posts && posts.length> 0) { %>
        <div class="feed-container">

          <% posts.forEach(post=> { %>
            <article class="post-card">

              <div class="post-meta">
                <a href="/g/<%= post.community_name.replaceAll(' ', '') %>" class="community-name">
                  g/<%= post.community_name.replaceAll(' ', '') %>
                </a>
                <span class="divider">•</span>
                <span class="author">Posted by <%= post.author_name %></span>
                <span class="divider">•</span>
                <span class="date">
                  <%= new Date(post.created_at).toLocaleDateString() %>
                </span>

                <!-- User Avatar -->
                <div
                  style="width: 28px; height: 28px; background-color: var(--surface-high); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 0.75rem; color: var(--text-muted); flex-shrink: 0; margin-left: auto;">
                  <div style="width: 16px; height: 16px;">
                    <%- include('partials/avatar.ejs', { id: post.author_icon }) %>
                  </div>
                </div>

              </div>

              <a href="/post/<%= post.id %>" style="text-decoration: none; color: inherit;">
                <h4 class="post-title">
                  <%= post.title %>
                </h4>
              </a>

              <p class="post-body">
                <%= post.body %>
              </p>

              <!-- Delete button conditionally appears -->
              <% if (locals.currentUser && locals.currentUser.id===post.user_id) { %>
                <div style="display: flex; justify-content: flex-end;">
                  <form action="/post/<%= post.id %>/delete" method="POST">
                    <button type="submit"
                      style="background: rgba(255, 77, 79, 0.1); border: 1px solid rgba(255, 77, 79, 0.3); color: var(--danger); display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; padding: 0.75rem 1rem; border-radius: 999px; transition: all 0.2s; font-size: 0.75rem;">
                      <span class="material-symbols-outlined" style="font-size: 1.0rem;">delete</span> Delete Post
                    </button>
                  </form>
                </div>
                <% } %>

            </article>
            <% }) %>

        </div>

      <div style="text-align: center; margin-top: 3rem; margin-bottom: 4rem;">
        <a href="/signup" class="btn-primary"
          style="background: transparent; border: 2px solid var(--primary); box-shadow: none;">
          Create an account to see more &rarr;
        </a>
      </div>

      <% } else { %>
        <div class="empty-state">
          <p>The fluid is still. Be the first to make a ripple.</p>
        </div>
        <% } %>

  </section>

  <%- include('partials/footer.ejs') %>