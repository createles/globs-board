<%- include('partials/header.ejs') %>
  <div class="new-post-container">
    <form action="/post/new" method="POST" class="new-post-form">
      <label for="new-post-community">
        <select name="communityId" id="new-post-community" required>
          <option value="" disabled selected>Select a community...</option>
        
          <% communities.forEach(community=> { %>
            <option value="<%= community.id %>">
              <%= community.community_name %>
            </option>
            <% }) %>
        </select>
      </label>
      <label for="new-post-title">
        <input type="text" name="title" id="new-post-title" required>
      </label>
      <label for="new-post-body">
        <textarea name="body" id="new-post-body" required></textarea>
      </label>

      <button type="submit">Create Post</button>
    </form>
  </div>
<%- include('partials/footer.ejs') %>