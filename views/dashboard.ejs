<%- include('partials/header.ejs') %>

  <div class="dashboard-container">

    <section class="user-profile-card">
      <div style="display: flex; align-items: center; gap: 1.5rem;">
        <!-- Avatar Icon -->
        <div
          style="width: 64px; height: 64px; background-color: var(--surface-high); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--tertiary); box-shadow: 0 0 20px rgba(161, 250, 255, 0.15); flex-shrink: 0;">
          <div style="width: 36px; height: 36px;">
            <%- include('partials/avatar.ejs', { id: currentUser.icon }) %>
          </div>
        </div>
        <!-- User name -->
        <div class="user-info">
          <h2>Hey, <%= currentUser.first_name %>!</h2>
          <p class="handle">@<%= currentUser.username %>
          </p>
        </div>

      </div>

      <a href="/post/new" class="btn-primary">Create New Post</a>
    </section>

    <section class="timeline-section">
      <!-- Tabs for feed -->
      <div style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; padding-left: 0.5rem;">

        <a href="/dashboard"
          style="text-decoration: none; font-size: 0.95rem; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.2s; padding-bottom: 0.5rem; margin-bottom: -0.65rem; color: <%= currentFeed === 'global' ? 'var(--primary)' : 'var(--text-muted)' %>; border-bottom: <%= currentFeed === 'global' ? '2px solid var(--primary)' : 'none' %>;">
          All Globs
        </a>

        <% if (locals.currentUser) { %>
          <a href="/dashboard?feed=followed"
            style="text-decoration: none; font-size: 0.95rem; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.2s; padding-bottom: 0.5rem; margin-bottom: -0.65rem; color: <%= currentFeed === 'followed' ? 'var(--primary)' : 'var(--text-muted)' %>; border-bottom: <%= currentFeed === 'followed' ? '2px solid var(--primary)' : 'none' %>;">
            Followed Globs
          </a>
          <% } %>

      </div>

      <% if (posts && posts.length> 0) { %>
        <div class="feed-container">

          <% posts.forEach(post=> { %>
            <article class="post-card">

              <div class="post-meta">
                <a href="/g/<%= post.community_name.replaceAll(' ', '') %>" class="community-name">
                  g/<%= post.community_name.replaceAll(' ', '') %>
                </a>
                <span class="divider">•</span>
                <span class="author">Posted by <%= post.author_name %></span>
                <span class="divider">•</span>
                <span class="date">
                  <%= new Date(post.created_at).toLocaleDateString() %>
                </span>

                <!-- User Avatar -->
                <div
                  style="width: 28px; height: 28px; background-color: var(--surface-high); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 0.75rem; color: var(--text-muted); flex-shrink: 0; margin-left: auto;">
                  <div style="width: 16px; height: 16px;">
                    <%- include('partials/avatar.ejs', { id: post.author_icon }) %>
                  </div>
                </div>

              </div>

              <a href="/post/<%= post.id %>" style="text-decoration: none; color: inherit;">
                <h4 class="post-title">
                  <%= post.title %>
                </h4>
              </a>

              <p class="post-body">
                <%= post.body %>
              </p>

              <!-- Delete button conditionally appears -->
              <% if (locals.currentUser && locals.currentUser.id===post.user_id) { %>
                <div style="display: flex; justify-content: flex-end;">
                  <form action="/post/<%= post.id %>/delete" method="POST">
                    <button type="submit"
                      style="background: rgba(255, 77, 79, 0.1); border: 1px solid rgba(255, 77, 79, 0.3); color: var(--danger); display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; padding: 0.75rem 1rem; border-radius: 999px; transition: all 0.2s; font-size: 0.75rem;">
                      <span class="material-symbols-outlined" style="font-size: 1.0rem;">delete</span> Delete Post
                    </button>
                  </form>
                </div>
                <% } %>

            </article>
            <% }) %>

        </div>
        <% } else { %>
          <div class="empty-state">
            <p>It's quiet in here... Be the first to say hello!</p>
          </div>
          <% } %>

    </section>
  </div>

  <%- include('partials/footer.ejs') %>