<%- include('partials/header.ejs') %>

<div class="dashboard-container">
  
  <section class="user-profile-card">
    <div class="user-info">
      <h2>Welcome back, <%= currentUser.first_name %>!</h2>
      <p class="handle">@<%= currentUser.username %></p>
    </div>
    <a href="/post/new" class="btn-primary">Create New Post</a>
  </section>

  <section class="timeline-section">
    <h3>Global Feed</h3>

    <% if (posts && posts.length > 0) { %>
      <div class="feed-container">
        
        <% posts.forEach(post => { %>
          <article class="post-card">
            
            <div class="post-meta">
              <a href="/g/<%= post.community_name %>" class="community-name" style="text-decoration: none;">
                g/<%= post.community_name %>
              </a>
              <span class="divider">•</span>
              <span class="author">Posted by <%= post.author_name %></span>
              <span class="divider">•</span>
              <span class="date">
                <%= new Date(post.created_at).toLocaleDateString() %>
              </span>
            </div>
            
            <h4 class="post-title"><%= post.title %></h4>
            
            <p class="post-body"><%= post.body %></p>
            
            <!-- Delete button conditionally appears -->
            <% if (locals.currentUser && currentUser.id===post.user_id) { %>
            
              <div class="post-actions" style="margin-top: 1rem; border-top: 1px solid #eee; padding-top: 0.5rem;">
                <form action="/post/<%= post.id %>/delete" method="POST" style="margin: 0;">
                  <button type="submit"
                    style="background: none; border: none; color: #dc3545; cursor: pointer; font-size: 0.9rem; padding: 0;">
                    🗑️ Delete Post
                  </button>
                </form>
              </div>
            
            <% } %>
            
          </article>
        <% }) %>
        
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>It's quiet in here... Be the first to say hello!</p>
      </div>
    <% } %>
    
  </section>
</div>

<%- include('partials/footer.ejs') %>