<% if (id == 1) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <polygon points="5,11 6,3 12,8" />
    <polygon points="19,11 18,3 12,8" />
    <circle cx="12" cy="13" r="7" />
    <circle cx="9" cy="12" r="1.5" fill="var(--surface-high)" />
    <circle cx="15" cy="12" r="1.5" fill="var(--surface-high)" />
  </svg>
<% } else if (id == 2) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <ellipse cx="5" cy="12" rx="3" ry="7" transform="rotate(-15 5 12)" />
    <ellipse cx="19" cy="12" rx="3" ry="7" transform="rotate(15 19 12)" />
    <circle cx="12" cy="12" r="6" />
    <circle cx="12" cy="15" r="2" fill="var(--surface-high)" />
  </svg>
<% } else if (id == 3) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <ellipse cx="9" cy="7" rx="2.5" ry="6" />
    <ellipse cx="15" cy="7" rx="2.5" ry="6" />
    <circle cx="12" cy="15" r="6" />
    <circle cx="12" cy="15" r="1.2" fill="var(--surface-high)" />
  </svg>
<% } else if (id == 4) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <rect x="5" y="6" width="14" height="14" rx="4" />
    <ellipse cx="12" cy="7" rx="6" ry="3" />
    <circle cx="9" cy="11" r="1.5" fill="var(--surface-high)" />
    <circle cx="15" cy="11" r="1.5" fill="var(--surface-high)" />
    <circle cx="11" cy="16" r="1" fill="var(--surface-high)" />
    <circle cx="13" cy="16" r="1" fill="var(--surface-high)" />
  </svg>
<% } else if (id == 5) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <line x1="12" y1="8" x2="12" y2="3" stroke="currentColor" stroke-width="2" />
    <circle cx="12" cy="3" r="2" />
    <rect x="6" y="8" width="12" height="12" rx="2" />
    <rect x="8" y="11" width="3" height="3" fill="var(--surface-high)" />
    <rect x="13" y="11" width="3" height="3" fill="var(--surface-high)" />
    <rect x="9" y="16" width="6" height="1.5" fill="var(--surface-high)" />
  </svg>
<% } else if (id == 6) { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <ellipse cx="12" cy="12" rx="8" ry="10" />
    <ellipse cx="8.5" cy="12" rx="2.5" ry="4" transform="rotate(-25 8.5 12)" fill="var(--surface-high)" />
    <ellipse cx="15.5" cy="12" rx="2.5" ry="4" transform="rotate(25 15.5 12)" fill="var(--surface-high)" />
  </svg>
<% } else { %>
  <svg viewBox="0 0 24 24" fill="currentColor">
    <circle cx="12" cy="8" r="4" />
    <path d="M4 20c0-4 4-7 8-7s8 3 8 7" />
  </svg>
<% } %>